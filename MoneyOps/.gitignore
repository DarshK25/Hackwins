# =============================================================
# MoneyOps Root .gitignore
# =============================================================

# Environment files
.env
*.env.local
*.env.*.local
!.env.example

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
pytest-cache-files-*/
htmlcov/
.coverage

# Java / Maven
target/
.m2repo/
*.class
*.jar
*.war

# Node / Frontend
node_modules/
dist/
.next/

# Logs / generated command output
*.log
compile_output.txt
test_out.txt
